# GitHub Developer Intelligence — Environment Configuration
# Copy to .env and fill in your values. .env is gitignored.

# --- AI providers (optional) ---

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# When unset, the app falls back to a local Ollama model, then to a
# deterministic local response.
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama endpoint used when no Gemini key is set.
# OLLAMA_URL=http://localhost:11434/api/generate
# DEFAULT_MODEL=gemma3-1b-jailbreak

# --- GitHub ---

# Personal access token for higher API rate limits (scopes: repo, read:org)
GITHUB_TOKEN=

# --- Server ---

# Port to listen on (default: 3010)
PORT=3010
DEV_INTEL_PORT=3010

# Interface to bind. Defaults to loopback only.
# Set to 0.0.0.0 only if you intentionally expose this service.
HOST=127.0.0.1

# --- Optional integrations ---

# Shared secret required for mutating routes (VM control, engine builds,
# app launches, dream trigger, LLM proxy). These routes return 403 until
# this is set.
ADMIN_TOKEN=

# Base URL of the optional local gateway (LLM proxy, VM and engine control).
# GATEWAY_URL=http://127.0.0.1:8081

# Absolute path to an Obsidian vault to expose read-only via /api/vault/*.
# Leave unset to disable the vault routes.
# OBSIDIAN_VAULT_PATH=/home/you/Documents/Obsidian Vault

# Path to the Kairos dream scheduler script invoked by /api/dream/trigger.
# Leave unset to disable the dream trigger.
# KAIROS_SCRIPT=/home/you/Projects/kairos_clean.py
